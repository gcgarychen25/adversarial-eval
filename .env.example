# Copy to .env (gitignored). Use plain KEY=value — no "export " prefix
# (export is only for pasting into a shell).

OPENAI_API_KEY=sk-...

# OpenCode Go default:
OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Other OpenAI-compatible endpoints (optional):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://<workspace>.maas.aliyuncs.com/compatible-mode/v1

# Model tip: default is deepseek-v4.1-flash (OpenCode Go). Pass --model <id> (no openai/ needed).
# Harbor may still show openai/<id>; that means "OpenAI-compatible HTTP", not OpenAI-only.

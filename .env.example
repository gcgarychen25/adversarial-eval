# Copy to .env (gitignored). Use plain KEY=value — no "export " prefix
# (export is only for pasting into a shell).

OPENAI_API_KEY=sk-...

# Real OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alibaba Model Studio (same Chat Completions protocol):
OPENAI_BASE_URL=https://<workspace>.maas.aliyuncs.com/compatible-mode/v1

# Model tip: pass --model deepseek-v4-pro-0813 (no openai/ needed).
# Harbor may still show openai/<id>; that means "OpenAI-compatible HTTP", not OpenAI-only.
